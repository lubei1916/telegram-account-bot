TELEGRAM_BOT_TOKEN=123456:replace_me

# Recommended: a WebSocket endpoint from Alchemy, Infura, QuickNode, Ankr, etc.
ETH_WS_URL=wss://eth-mainnet.g.alchemy.com/v2/replace_me
ETHERSCAN_API_KEY=

# TronGrid mainnet API. You can also use a private full node with a compatible API.
TRON_FULL_HOST=https://api.trongrid.io
TRON_API_KEY=

# Mainnet USDT contracts. Defaults are official Tether USDT contracts.
USDT_ERC20_CONTRACT=0xdAC17F958D2ee523a2206206994597C13D831ec7
USDT_TRC20_CONTRACT=TXLAQ63Xg1NAzckPwKHvzw7CSEmLMEqcdj

# TRX balance checks are done by fast polling. 3000 ms is usually a good balance.
TRON_POLL_MS=3000

# Optional comma-separated Telegram user IDs. When set, only these users can use the bot.
ADMIN_USER_IDS=

# Optional storage path. Defaults to ./data/watchers.json
STORAGE_PATH=./data/watchers.json

# Optional log level: trace, debug, info, warn, error
LOG_LEVEL=info
